# Boating/cannon/top-lesser-offensive.razor
# Hotkey-bindable: fire Top row Lesser offensive ability.
if cooldown "Hard to Port"
    overhead "Hard to Port still active" 38
    hotkey "Play Script: uoo-scripts\Bots\_utilities\goto-base"
    stop
endif
clearsysmsg
hotkey '> Interrupt'
hotkey "Cancel Current Target"
say "[LesserAbility"
getlabel backpack ping
if insysmsg "fire its cannons again" or insysmsg "you must wait"
    overhead "Cannons Cooling..." 38
    hotkey "Play Script: uoo-scripts\Bots\_utilities\goto-base"
    stop
endif
if insysmsg "target this ability?"
    @setvar! "cannon_cd" 15000
    @setvar! "cannon_msg" "*Top Lesser Ability*"
    hotkey "Play Script: uoo-scripts\Bots\_utilities\cannon-fire-target"
    stop
endif
cooldown "Hard to Port" 15000
overhead "Ability Cooling..." 38
hotkey "Play Script: uoo-scripts\Bots\_utilities\goto-base"



