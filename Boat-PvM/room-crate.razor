//This script expects to be called from the main organizer script so wants some pre-set variables

if findtype 3645 ground -1 -1 1 as 'shippingcrate'
    overhead 'Found Shipping Crate!' 18
    dclick 'shippingcrate'
    wait 250

    // 1. Deposit gold and doubloons to safe
    if findtype 'bank deposit safe' ground any any 2 as safe
        overhead 'Found Safe'
        while findtype 'gold coin' shippingcrate as goldstacks
            overhead 'Depositing gold.'
            @drop backpack
            lift goldstacks 60000
            wait 250
            drop safe -1 -1 0
            wait 500
        endwhile
        while findtype 'doubloon' shippingcrate as dubbies
            overhead 'Depositing dubs'
            @drop backpack
            lift dubbies 60000
            wait 250
            drop safe -1 -1 0
            wait 500
        endwhile
    else
        overhead 'Did not find safe'
    endif

    // 2. Stockpile pulls resources from crate
    if findtype "resource container" ground -1 -1 2 as stockpile
        overhead 'Stockpile: pulling from crate...' 88
        menu stockpile 0
        wft 500
        target 'shippingcrate'
        getlabel backpack pingCheck
        wait 500
    else
        overhead 'Stockpile not found within 2 tiles' 34
    endif

    // 3. Magic item recycler: dump crate in, identify, recycle, dump out
    if findtype "ornate elven chest|magic item recycler" ground -1 -1 2 as recycler
        overhead 'DBG: recycler found, dclicking...' 33
        dclick recycler
        wait 750
        if gumpexists 0
            overhead 'DBG: gump open, btn3 dump-in...' 63
        else
            overhead 'DBG: NO gump after dclick' 34
        endif
        gumpresponse 3
        wft 2000
        if targetexists
            overhead 'DBG: cursor got, targeting crate...' 63
            target 'shippingcrate'
            overhead 'DBG: targeted, dclicking to reopen...' 33
            dclick recycler
            wait 1500
            if gumpexists 0
                overhead 'DBG: gump open, btn7 identify...' 63
            else
                overhead 'DBG: NO gump after 2nd dclick' 34
            endif
            gumpresponse 7
            wait 3000
            if gumpexists 0
                overhead 'DBG: gump open after ID, btn6 recycle...' 63
            else
                overhead 'DBG: NO gump after identify' 34
            endif
            gumpresponse 6
            wait 2000
            overhead 'DBG: btn6 recycle 2...' 33
            gumpresponse 6
            wait 1500
        else
            overhead 'DBG: no cursor after btn3' 34
        endif
        overhead 'Recycler: dumping to inventory...' 88
        menu recycler 2
        wait 500
    else
        overhead 'Recycler not found within 2 tiles' 34
    endif

else
    overhead 'No shipping crate found' 34
endif

overhead '~~ Crate done, running organizer ~~' 48
script 'inn-dropper'
