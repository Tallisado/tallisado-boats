@setvar! globalTimeout 250
@setvar! tomeChest 0x411EDE22
@setvar! myRecallScrollsChest 0x479D6FC8
@setvar! bandagesToMoveIntoTrappedPouches 25
@setvar! putPotsInUnTrappedLootPouch 0
@setvar! prettyPotionOrganizer 0
@setvar! prettyItemOrganizer 1
@setvar! lootdropoff 0x40E38214
@setvar! unidentifieddropoff 0x6062787E
@setvar! identifieddropoff 0x45B3AF28
@setvar! leatherdropoff 0x43446BC7
@setvar! innChest 1584726355

overhead '~~ Room Organizer starting ~~' 48

// ============================================================
// PHASE 1: SHIPPING CRATE
// ============================================================

overhead '[DBG] Phase1: looking for shipping crate at feet (range 0)' 88
@clearignore
if findtype 3645 ground -1 -1 0 as shippingcrate
    getlabel shippingcrate crateDesc
    overhead '[DBG] Crate found, desc={{crateDesc}}' 88
    @setvar! crateSkip 0
    if "locked" in crateDesc
        @setvar! crateSkip 1
    elseif "0 items, 0 stones" in crateDesc
        @setvar! crateSkip 1
    endif
    if crateSkip = 1
        overhead 'Crate locked/empty - skipping' 34
    else
        overhead 'Found Shipping Crate!' 18
        dclick shippingcrate
        wait 250

        // Deposit gold and doubloons
        if findtype 'bank deposit safe' ground -1 -1 2 as safe
            overhead '[DBG] Safe found - depositing gold/doubloons' 88
            while findtype 'gold coin' shippingcrate as goldstacks
                @drop backpack
                lift goldstacks 60000
                wait 250
                drop safe -1 -1 0
                wait 500
            endwhile
            while findtype 'doubloon' shippingcrate as dubbies
                @drop backpack
                lift dubbies 60000
                wait 250
                drop safe -1 -1 0
                wait 500
            endwhile
        else
            overhead '[DBG] Safe NOT found within 2 tiles' 34
        endif

        // Stockpile pulls resources from crate
        overhead '[DBG] Looking for stockpile (crate)' 88
        if findtype "resource container" ground -1 -1 2 as stockpile
            overhead '[DBG] Stockpile found - pulling from crate' 88
            menu stockpile 0
            wft 2000
            if targetexists
                target shippingcrate
                getlabel backpack pingCheck
                wait 500
            else
                overhead '[DBG] Stockpile: no cursor appeared' 34
            endif
        else
            overhead '[DBG] Stockpile NOT found within 2 tiles' 34
        endif

        // Recycler: dump crate in, identify, recycle
        overhead '[DBG] Looking for recycler' 88
        if findtype "ornate elven chest|magic item recycler" ground -1 -1 2 as recycler
            overhead '[DBG] Recycler found - dumping crate in' 88
            dclick recycler
            wait 750
            gumpresponse 3
            wft 2000
            if targetexists
                clearsysmsg
                target shippingcrate
                settimer recyclerDumpTimer 0
                @setvar! recyclerDumpDone 0
                while recyclerDumpDone = 0
                    if insysmsg "recyclable items found"
                        @setvar! recyclerDumpDone 1
                    elseif insysmsg "no recyclable"
                        @setvar! recyclerDumpDone 1
                    elseif timer recyclerDumpTimer >= 8000
                        @setvar! recyclerDumpDone 1
                    endif
                    wait 100
                endwhile
                overhead '[DBG] Recycler: dump done - waiting before ID' 88
                wait 1000
                overhead '[DBG] Recycler: opening gump for ID' 88
                dclick recycler
                wait 2000
                overhead '[DBG] Recycler: sending gumpresponse 7 (identify)' 88
                gumpresponse 7
                wait 5000
                overhead '[DBG] Recycler: sending gumpresponse 6 (recycle)' 88
                gumpresponse 6
                wait 1500
                overhead '[DBG] Recycler: sending gumpresponse 6 (confirm)' 88
                gumpresponse 6
                wait 1500
                overhead '[DBG] Recycler: ID+crush sequence done' 88
            else
                overhead '[DBG] Recycler: no cursor for dump' 34
            endif

            // Stockpile pulls resources from recycler (before vault)
            overhead '[DBG] Looking for stockpile (recycler)' 88
            if findtype "resource container" ground -1 -1 2 as stockpile
                overhead '[DBG] Stockpile found - pulling from recycler' 88
                menu stockpile 0
                wft 2000
                if targetexists
                    target recycler
                    getlabel backpack pingCheck
                    wait 500
                else
                    overhead '[DBG] Stockpile: no cursor appeared' 34
                endif
            else
                overhead '[DBG] Stockpile NOT found (recycler pass)' 34
            endif

            // Vault pulls magic items from recycler (after stockpile)
            overhead '[DBG] Looking for vault (to pull from recycler)' 88
            if findtype "magic item chest|sm magic item vault" ground -1 -1 2 as vault
                overhead '[DBG] Vault found - pulling from recycler' 88
                menu vault 0
                wft 2000
                if targetexists
                    target recycler
                    wait 200
                else
                    overhead '[DBG] Vault: no cursor appeared' 34
                endif
            else
                overhead '[DBG] Vault NOT found within 2 tiles' 34
            endif

            // Pull fish from crate to backpack
            overhead '[DBG] Pulling fish from crate' 88
            while findtype 17619|7710|17617|2508|2463|2426 shippingcrate as fish
                lift fish 60000
                drop backpack -1 -1 0
                while queued
                endwhile
            endwhile

            // Pick up crate (only if not secured to house)
            if "secure" in crateDesc
                overhead '[DBG] Crate is secured - skipping lift' 88
            else
                overhead '[DBG] Picking up crate' 88
                @drop backpack
                lift shippingcrate 1
                wait 500
                if targetexists
                    overhead '[DBG] Unexpected cursor after lift - cancelling' 34
                    hotkey "cancel current target"
                    wait 200
                endif
                drop backpack -1 -1 0
                wait 500
            endif

            // Dump recycler remaining to inventory
            overhead '[DBG] Recycler: dumping remaining to inventory' 88
            menu recycler 2
            wait 500
        else
            overhead '[DBG] Recycler NOT found within 2 tiles' 34
        endif

        // Rares into chest bags
        overhead '[DBG] Rares chest section starting' 88
        if not varexist raresChest
            overhead 'Target your rares chest' 88
            setvar raresChest
        endif
        if find raresChest ground -1 -1 2
            overhead '[DBG] Rares chest found - depositing' 88
            dclick raresChest
            wait 500
            @ignore shippingcrate
            @setvar! raresAbort 0
            while findtype 4225|31169|3568|3570|3571|3572|3573|3713|3719|3721|3740|3742|3762|3763|3834|3909|3911|3913|3915|3917|3920|3922|3932|3934|3937|3938|5040|5042|5044|5046|5049|5112|5115|5117|5119|5121|5123|5125|5127|5177|5179|5181|5182|5185|5187|7026|7027|7029|7031|7033|7034|7035|7107|7109|10245|20006|20008|20010|20012|20014|20016|22187|30988|30989|30990|30991|30992|30993|30994|30995|30996|30997|30998|30999|31000|31001|31002|31014|31017|31019|31021|31023|31025|31027|31029|31031|31033|31035|31037|31038|31041|31043|31045|31047|31049|31051|31053|31055|31128|31130|31141|31142|31176|31178|31180|31182|31184|31186|31188|31190|576|2472|2475|2594|2597|2744|2750|2760|2771|2778|2799|3648|3649|3650|3651|3708|3712|3735|3736|3737|3738|3827|3836|3838|3839|3842|3843|3985|4248|5356|5359|5981|8826|12686|15297|17087|17686|19717|22244|22336|23996|23997|24343|24434|29025|29036|29040|29832|29833|43166|43179|43206|48405|48407|3834|6238|8786|8787|8901|11881|11882|11883|11884|11885|11886|11887|11888|11889|11890|11891|11893|11895|29103|29104|29105|41471|42516|45340|45823|5056|5059|5060|5061|5063|5070|5074|5075|5076|5078|5085|5089|5090|5101|5103|5105|5106|5129|5131|5132|5135|5138|5139|5142|5143|5144|5146|5201|5203|5204|5205|5207|7169|7170|7173|7175|7177|7179|7181|7610|7947|31003|31004|31005|31006|31007|31008|31009|31010|31011|31012|31015|31191|4025|4026|29363|29030|3865|3859|3885|3856|3878|3877|3873|3861|3862|3980|3981|3976|3973|3974|3962|3963|3972|6264|6263|22326|27611|9917|3821|8455|5362|8454|5901|7163|3617|3903 backpack as item
                if raresAbort = 1
                    break
                endif
                getlabel item rareDesc
                if 'blessed' in rareDesc or 'aspect' in rareDesc
                    @ignore item
                else
                    @setvar! rarePlaced 0
                    while rarePlaced = 0
                        if findtype 'bag|pouch' raresChest as rareBag
                            getlabel rareBag bagDesc
                            if '125 items' in bagDesc
                                @ignore rareBag
                            else
                                lift item 60000
                                drop rareBag -1 -1 -1
                                wait 250
                                @setvar! rarePlaced 1
                                @ignore item
                            endif
                        else
                            overhead 'Rares: bags full!' 34
                            @setvar! rarePlaced 1
                            @setvar! raresAbort 1
                        endif
                    endwhile
                endif
            endwhile
            @clearignore
        else
            overhead '[DBG] Rares chest NOT in range - skipping' 34
        endif

    endif
else
    overhead '[DBG] No shipping crate found within 2 tiles' 34
endif

// Fishing nets run regardless of whether a crate was found
overhead '[DBG] Fishing nets section - innChest={{innChest}}' 88
while findtype "fishing net" backpack 2785 as snet
    lift snet 60000
    drop innChest -1 -1 0
    while queued
    endwhile
endwhile
while findtype "fishing net" backpack 2851 as snet
    lift snet 60000
    drop innChest -1 -1 0
    while queued
    endwhile
endwhile
while findtype "fishing net" backpack 2880 as snet
    lift snet 60000
    drop innChest -1 -1 0
    while queued
    endwhile
endwhile
while findtype "fishing net" backpack 2963 as snet
    lift snet 60000
    drop innChest -1 -1 0
    while queued
    endwhile
endwhile
while findtype "fishing net" backpack 2839 as snet
    lift snet 60000
    drop innChest -1 -1 0
    while queued
    endwhile
endwhile
while findtype "fishing net" backpack 2871 as snet
    lift snet 60000
    drop innChest -1 -1 0
    while queued
    endwhile
endwhile
while findtype "fishing net" backpack 2795 as snet
    lift snet 60000
    drop innChest -1 -1 0
    while queued
    endwhile
endwhile
while findtype "fishing net" backpack 2814 as snet
    lift snet 60000
    drop innChest -1 -1 0
    while queued
    endwhile
endwhile
while findtype "fishing net" backpack 2900 as snet
    lift snet 60000
    drop innChest -1 -1 0
    while queued
    endwhile
endwhile

// ============================================================
// PHASE 2: ROOM ORGANIZER
// ============================================================

overhead '[DBG] Phase2: room organizer starting' 88

// Smelt ore at forge
if skill "Mining" >= 50 and findtype "forge" ground -1 -1 2
    overhead '[DBG] Forge found - smelting' 88
    while findtype 6585 backpack as item
        dclick item
        wait 650
        @ignore item
    endwhile
endif

// Repair bench
overhead '[DBG] Looking for repair bench' 88
if findtype "repair bench" ground -1 -1 2 as bench
    overhead '[DBG] Repair bench found' 88
    clearsysmsg
    dclick bench
    getlabel backpack jaseowns_PingCheck
    if insysmsg "You do not have any items equipped or in your backpack in need of repairs."
        overhead '[DBG] Repair: nothing to repair' 88
    else
        settimer lilJaseTimer 0
        while timer lilJaseTimer <= 5000
            if insysmsg "Repair"
                break
            endif
        endwhile
        removetimer lilJaseTimer
    endif
else
    overhead '[DBG] Repair bench NOT found' 88
endif

// Bard instrument
if skill "Discordance" > 0 or skill "Provocation" > 0 or skill "Peacemaking" > 0
    overhead '[DBG] Bard skill detected - equipping instrument' 88
    while not dead
        if skill "Discordance" > 0
            useskill 'Discordance'
        elseif skill "Peacemaking" > 0
            useskill 'Peacemaking'
        elseif skill "Provocation" > 0
            useskill 'Provocation'
        endif
        wft 500
        if insysmsg "What instrument"
            if findtype 3740|3742|3762|3763|10245|20006|20008|20010|20012|20014|20016 backpack as jaseowns_Instrument
                target jaseowns_Instrument
                @setvar! jase_MyInny jaseowns_Instrument
            else
                overhead "I do not have an instrument" 34
                if targetexists
                    hotkey "cancel current target"
                endif
                break
            endif
            wft 500
        endif
        if targetexists
            hotkey "Target Self"
            break
        endif
    endwhile
endif

// Magic item vault: pull items from ground/self into vault
overhead '[DBG] Looking for magic item vault (pull from self)' 88
if findtype "magic item chest|sm magic item vault" ground -1 -1 2 as vault
    overhead '[DBG] Vault found - pulling from self' 88
    menu vault 0
    wft 2000
    if targetexists
        target backpack
        wait 500
    else
        overhead '[DBG] Vault pull-from-self: no cursor appeared' 34
    endif
else
    overhead '[DBG] Vault NOT found within 2 tiles' 34
endif

// Storage shelf: pull items from self
overhead '[DBG] Looking for storage shelf (pull from self)' 88
if findtype "storage shelf|gothic storage shelf|stump storage shelf" ground -1 -1 2 as shelf
    overhead '[DBG] Shelf found - pulling from self' 88
    menu shelf 0
    wft 2000
    if targetexists
        target self
        wait 200
        gumpclose 3232825965
    else
        overhead '[DBG] Shelf pull-from-self: no cursor appeared' 34
    endif
else
    overhead '[DBG] Shelf NOT found within 2 tiles' 34
endif

// Tomes
overhead '[DBG] Tome section' 88
dclick tomeChest
wait 200
if tomeChest = myRecallScrollsChest
    // do nothing
else
    dclick myRecallScrollsChest
    wait 200
endif
@clearignore
while findtype 29104 ground -1 -1 2 as tome
    menu tome 0
    wait 200
    @ignore tome
endwhile
while findtype 29104 tomeChest -1 -1 2 as tome
    menu tome 0
    wait 200
    @ignore tome
endwhile
@clearignore

// Keep instrument out of sorting
if varexist jase_MyInny and find jase_MyInny backpack
    getlabel jase_MyInny innyDesc
    overhead "Ignoring instrument: {{innyDesc}}" 77
    @ignore jase_MyInny
endif

// Gold and doubloons to safe
overhead '[DBG] Looking for safe (backpack gold)' 88
if findtype "bank deposit safe" ground -1 -1 2 as safe
    overhead '[DBG] Safe found - depositing backpack gold' 88
    while findtype "gold coin" backpack as gold
        lift gold 60000
        drop safe -1 -1 -1
        wait globalTimeout
    endwhile
    while findtype "doubloon" backpack as joubloons
        lift joubloons 60000
        drop safe -1 -1 -1
        wait globalTimeout
    endwhile
else
    overhead '[DBG] Safe NOT found within 2 tiles' 34
endif

// Recycler: pull recyclable items from backpack, then vault collects them
overhead '[DBG] Looking for recycler (identify backpack)' 88
@setvar! recyclerGotItems 0
if findtype "ornate elven chest|magic item recycler" ground -1 -1 2 as recycler
    overhead '[DBG] Recycler found - pulling recyclables from backpack' 88
    clearsysmsg
    menu recycler 1
    wait 500
    getlabel backpack pingCheck
    if insysmsg "recyclable items found"
        @setvar! recyclerGotItems 1
        overhead '[DBG] Recycler loaded items from backpack' 88
    else
        overhead '[DBG] Recycler: no items loaded from backpack' 88
    endif
else
    overhead '[DBG] Recycler NOT found within 2 tiles' 34
endif

// Vault: pull from recycler only if it received items
overhead '[DBG] Vault pull-from-recycler (recyclerGotItems={{recyclerGotItems}})' 88
if recyclerGotItems = 1
    if findtype "magic item chest|sm magic item vault" ground -1 -1 2 as vault
        overhead '[DBG] Vault found - pulling from recycler' 88
        menu vault 0
        wft 2000
        if targetexists
            target recycler
            wait 500
            if targetexists
                overhead '[DBG] Vault pull-from-recycler: cancelling stray cursor' 34
                hotkey "cancel current target"
                wait 200
            endif
        else
            overhead '[DBG] Vault pull-from-recycler: no cursor appeared' 34
        endif
    else
        overhead '[DBG] Vault NOT found (recycler pass)' 34
    endif
else
    overhead '[DBG] Vault pull-from-recycler: skipped (recycler empty)' 88
endif

// Resource container: pull resources from self
overhead '[DBG] Looking for resource container (pull from self)' 88
if findtype "resource container" ground -1 -1 2 as resource
    overhead '[DBG] Resource container found - pulling from self' 88
    menu resource 0
    wft 2000
    if targetexists
        target self
        wait 500
        if targetexists
            overhead '[DBG] Resource container: cancelling stray cursor' 34
            hotkey "cancel current target"
            wait 200
        endif
    else
        overhead '[DBG] Resource container: no cursor appeared' 34
    endif
else
    overhead '[DBG] Resource container NOT found within 2 tiles' 34
endif

// Ignore spellbook during sorting
if findtype "spellbook" self 0 as mySpellBook
    @ignore mySpellBook
endif

// Sort loot: unidentified → unidentifieddropoff, leather → leatherdropoff, rest → lootdropoff
overhead '[DBG] Loot sort starting' 88
while findtype 4225|31169|3568|3570|3571|3572|3573|3713|3719|3721|3740|3742|3762|3763|3834|3909|3911|3913|3915|3917|3920|3922|3932|3934|3937|3938|5040|5042|5044|5046|5049|5112|5115|5117|5119|5121|5123|5125|5127|5177|5179|5181|5182|5185|5187|7026|7027|7029|7031|7033|7034|7035|7107|7109|10245|20006|20008|20010|20012|20014|20016|22187|30988|30989|30990|30991|30992|30993|30994|30995|30996|30997|30998|30999|31000|31001|31002|31014|31017|31019|31021|31023|31025|31027|31029|31031|31033|31035|31037|31038|31041|31043|31045|31047|31049|31051|31053|31055|31128|31130|31141|31142|31176|31178|31180|31182|31184|31186|31188|31190|576|2472|2475|2594|2597|2744|2750|2760|2771|2778|2799|3648|3649|3650|3651|3708|3712|3735|3736|3737|3738|3827|3836|3838|3839|3842|3843|3985|4248|5356|5359|5981|8826|12686|15297|17087|17686|19717|22244|22336|23996|23997|24343|24434|29025|29036|29040|29832|29833|43166|43179|43206|48405|48407|3834|6238|8786|8787|8901|11881|11882|11883|11884|11885|11886|11887|11888|11889|11890|11891|11893|11895|29103|29104|29105|41471|42516|45340|45823|5056|5059|5060|5061|5063|5070|5074|5075|5076|5078|5085|5089|5090|5101|5103|5105|5106|5129|5131|5132|5135|5138|5139|5142|5143|5144|5146|5201|5203|5204|5205|5207|7169|7170|7173|7175|7177|7179|7181|7610|7947|31003|31004|31005|31006|31007|31008|31009|31010|31011|31012|31015|31191|4025|4026|24434|43206|29363|43166|22336|29348|17087|3985|8826|3827|29030|3836|5981|4248|5359|3839|3838|3843|2597|29036|48407|3834|3865|3859|3885|3856|3878|3877|3873|3861|3862|576|5123|7177|7027|3920|5131|5179|5075|3980|5060|5076|5042|10245|3938|3913|7169|3909|5063|5089|3981|7170|7033|3976|3762|5040|5103|5117|7181|7029|3568|6264|3742|5139|6263|7026|5125|3740|5121|3973|3974|5204|5105|5185|5078|5115|7175|5059|7034|3915|5112|5070|5049|5119|5205|5046|3962|3934|7035|3911|7179|5106|5143|3573|3719|5177|7610|5181|3917|5132|3963|7031|5207|5056|5085|3763|5129|5187|3721|3972|5138|3570|5101|5061|5074|5142|5182|5146|6265|5090|5203|5044|5144|3932|5201|5127|3572|7173|5135|3937|3571|22326|27611|9917|3821|5356|8455|5362|45315|8454|22187|5901|7163|3617|3903|12686 backpack as item
    getlabel item checkForBlessed
    overhead "{{checkForBlessed}}"
    if "blessed" in checkForBlessed or "aspect" in checkForBlessed
        @ignore item
    else
        getlabel lootdropoff desc
        if "125 items" in desc
            overhead "Our lootdropoff box is full!" 34
            overhead "Our lootdropoff box is full!" 34
            overhead "Our lootdropoff box is full!" 34
            sysmsg "Our lootdropoff box is full!" 34
            break
        endif
        getlabel unidentifieddropoff desc
        if "125 items" in desc
            overhead "Our unidentifieddropoff box is full!" 34
            overhead "Our unidentifieddropoff box is full!" 34
            overhead "Our unidentifieddropoff box is full!" 34
            sysmsg "Our unidentifieddropoff box is full!" 34
            break
        endif
        if "unidentified" in checkForBlessed
            lift item 60000
            drop unidentifieddropoff -1 -1 -1
            wait globalTimeout
        elseif "leather|dullhide|shadowhide|copperhide|bronzehide|Goldenhide|Rosehide|Verehide|Valehide|Avarhide" in checkForBlessed
            overhead "LEATHER"
            lift item 60000
            drop leatherdropoff -1 -1 -1
            wait globalTimeout
        else
            lift item 60000
            drop lootdropoff -1 -1 -1
            wait globalTimeout
        endif
        @ignore item
    endif
endwhile
@clearignore

// Leather pass
overhead '[DBG] Leather pass' 88
while findtype 4225 backpack as item
    getlabel lootdropoff desc
    if "125 items" in desc
        overhead "Our lootdropoff box is full!" 34
        overhead "Our lootdropoff box is full!" 34
        overhead "Our lootdropoff box is full!" 34
        sysmsg "Our lootdropoff box is full!" 34
        break
    endif
    lift item 60000
    drop lootdropoff -1 -1 -1
    wait globalTimeout
