// Storage shelf restock from self
overhead '[DBG] Looking for shelf (restock)' 88
if findtype "storage shelf" ground -1 -1 2 as shelf
    overhead '[DBG] Shelf found - restocking' 88
    menu shelf 1
    wait 200
else
